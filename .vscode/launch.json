{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "DAP: Layout Resize Tool Probe",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "exec",
        "vitest",
        "run",
        "tests/unit/layout-resize-tool-dap-probe.test.ts",
        "--inspect-brk",
        "--no-file-parallelism"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    }
  ]
}
