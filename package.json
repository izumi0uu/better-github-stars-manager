{
  "name": "better-github-stars-manager",
  "version": "1.0.9",
  "description": "Manage your GitHub starred repos: tag, note, filter, search across thousands of stars. UI injected into the stars page.",
  "packageManager": "pnpm@10.33.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.2",
      "onFail": "error"
    }
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.12",
      "postcss": "8.5.26"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent-diagnostics": "node scripts/start-agent-dev-diagnostics.mjs",
    "build": "tsc --noEmit && vite build",
    "package:extension": "node scripts/package-extension.mjs",
    "build:agent-dev-diagnostics": "node scripts/build-agent-dev-diagnostics.mjs",
    "capture:store-screenshots": "node scripts/capture-store-screenshots.mjs",
    "verify:agent-runtime": "node scripts/run-agent-runtime-verification.mjs",
    "verify:agent-release-gates": "node scripts/verify-agent-release-gates.mjs",
    "preinstall": "node scripts/enforce-package-manager.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:vitest": "vitest run",
    "test:logic": "vitest run tests/unit",
    "test:commit-message": "vitest run tests/unit/commit-message.test.mjs",
    "test:ime": "vitest run tests/unit/ime-input.test.mjs",
    "test:tag-draft": "vitest run tests/unit/tag-draft.test.mjs",
    "test:integration": "vitest run tests/integration/integration.test.ts",
    "test:shape": "vitest run tests/unit/shape.test.ts",
    "test:regressions": "vitest run tests/regressions/auth tests/regressions/fuzz tests/regressions/query tests/regressions/storage tests/regressions/sync",
    "test:runtime": "node tests/runtime/puppeteer-runtime.test.mjs",
    "test:runtime:agent-diagnostics": "node tests/runtime/agent-diagnostics-release-isolation.mjs",
    "test:runtime:agent-scenarios": "node tests/runtime/agent-scenarios-extension-host.mjs",
    "test:runtime:agent-session": "node tests/runtime/agent-session-extension-host.mjs",
    "test:runtime:agent-worker-recovery": "node tests/runtime/agent-worker-recovery-extension-host.mjs",
    "test:runtime:agent-ui-history": "node tests/runtime/agent-ui-history-extension-host.mjs",
    "test:runtime:agent-composition": "node tests/runtime/agent-runtime-composition.mjs",
    "test:runtime:organize-job-host": "node tests/runtime/organize-job-extension-host.mjs",
    "test:runtime:organize-job-recovery": "GSM_RUNTIME_WORKER_RECOVERY=1 node tests/runtime/organize-job-extension-host.mjs",
    "test:smoke": "node tests/runtime/extension-browser-smoke.mjs",
    "test:smoke:headless-basic": "node tests/runtime/smoke.test.mjs",
    "test:verify-chrome": "node tests/manual/e2e/verify-chrome.mjs",
    "test:verify-first-run": "node tests/manual/e2e/verify-first-run.mjs",
    "test:reset-gist": "node tests/manual/ops/reset-gist-sync.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/language-server": "^0.16.0",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "vscode-langservers-extracted": "^4.10.0"
  }
}
